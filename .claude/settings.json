{
  "permissions": {
    "allow": [
      "Bash(pytest:*)"
    ],
    "deny": [
      "Read(./.env)"
    ],
    "ask": [
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/run_tests.py"
          }
        ]
      }
    ]
  }
}
